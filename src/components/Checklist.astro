---
interface Props {
  title?: string;
  items: string[];
}
const { title = 'Before you go', items } = Astro.props;
---
<section class="mt-10 rounded-2xl border border-slate-200 bg-[#f8fafc] p-6">
  <h2 class="text-xl font-black text-[#143844]">{title}</h2>
  <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-700">
    {items.map((it) => (
      <li class="flex gap-2"><span aria-hidden="true" class="mt-0.5 select-none font-bold text-[#a66f2d]">☐</span><span>{it}</span></li>
    ))}
  </ul>
</section>

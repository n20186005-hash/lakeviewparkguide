---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<section id="faq" class="mt-12">
  <h2 class="text-2xl font-black text-[#143844]">Frequently asked questions</h2>
  <div class="mt-5 space-y-4">
    {items.map((it) => (
      <details class="group rounded-2xl border border-slate-200 bg-white p-5 card-shadow">
        <summary class="flex cursor-pointer items-center justify-between font-bold text-[#143844]">
          <span>{it.q}</span>
          <span aria-hidden="true" class="text-[#a66f2d] transition group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 leading-7 text-slate-700">{it.a}</p>
      </details>
    ))}
  </div>
</section>

---
import SubpageLayout from './SubpageLayout.astro';
import Checklist from '../components/Checklist.astro';
import { mapsUrl, type Attraction } from '../data/attractions';

interface Props { attraction: Attraction }
const { attraction: a } = Astro.props;
const map = mapsUrl(a.mapsQuery);
const link = 'font-semibold text-[#a66f2d] underline';
const h2 = 'text-2xl font-black text-[#143844]';
const card = 'rounded-2xl border border-slate-200 bg-white p-5 card-shadow';
---
<SubpageLayout
  title={a.title}
  description={a.description}
  path={`/${a.slug}/`}
  eyebrow={a.eyebrow}
  breadcrumb={[
    { name: 'Home', href: '/' },
    { name: 'Nearby attractions', href: '/nearby-attractions/' },
    { name: a.breadcrumbName, href: `/${a.slug}/` },
  ]}
  faq={a.faq}
  related={a.related}
>
  <article class="space-y-10">
    <!-- 1. Hero: name (h1 in layout) + tagline + rating + hours + location link -->
    <section class="rounded-[2rem] bg-[#f3ede0] p-6 md:p-8">
      <p class="text-lg font-bold leading-8 text-[#5b4a2f]">{a.tagline}</p>
      <dl class="mt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-black uppercase tracking-wider text-[#a66f2d]">Rating</dt>
          <dd class="mt-1 text-sm leading-7 text-[#5b4a2f]">{a.ratingNote} <a class={link} href={map} target="_blank" rel="noopener noreferrer">View live listing ↗</a></dd>
        </div>
        <div>
          <dt class="text-xs font-black uppercase tracking-wider text-[#a66f2d]">Hours</dt>
          <dd class="mt-1 text-sm leading-7 text-[#5b4a2f]">{a.hoursNote}</dd>
        </div>
      </dl>
      <a class="mt-5 inline-block rounded-full bg-[#143844] px-5 py-2.5 text-sm font-bold text-white" href={map} target="_blank" rel="noopener noreferrer">View location on Google Maps ↗</a>
    </section>

    <!-- 2. Explore / introduction -->
    <section>
      <h2 class={h2}>Explore {a.name}</h2>
      {a.intro.map((p) => <p class="mt-3 leading-8">{p}</p>)}
    </section>

    <!-- 3. Visitor tips -->
    <section>
      <h2 class={h2}>Visitor tips</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 leading-8">
        {a.tips.map((t) => <li>{t}</li>)}
      </ul>
    </section>

    <!-- 4. Highlights -->
    <section>
      <h2 class={h2}>Highlights</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 leading-8">
        {a.highlights.map((t) => <li>{t}</li>)}
      </ul>
    </section>

    <!-- 5. About -->
    <section>
      <h2 class={h2}>About {a.name}</h2>
      {a.about.map((p) => <p class="mt-3 leading-8">{p}</p>)}
    </section>

    <!-- 6. Key facts table -->
    <section>
      <h2 class={h2}>Key facts</h2>
      <dl class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white px-5 card-shadow">
        {a.facts.map((f) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[12rem_1fr] sm:gap-4">
            <dt class="text-sm font-bold text-[#143844]">{f.label}</dt>
            <dd class="text-sm leading-7 text-slate-700">{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- 7. Opening hours -->
    <section>
      <h2 class={h2}>Opening hours</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {a.hours.map((s) => (
          <div class={card}>
            <h3 class="font-black text-[#143844]">{s.title}</h3>
            <p class="mt-2 text-sm leading-7 text-slate-700">{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 8. Ticket prices -->
    <section>
      <h2 class={h2}>Tickets &amp; admission</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {a.tickets.map((s) => (
          <div class={card}>
            <h3 class="font-black text-[#143844]">{s.title}</h3>
            <p class="mt-2 text-sm leading-7 text-slate-700">{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 9. Getting there / transport modes -->
    <section>
      <h2 class={h2}>Getting there</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {a.transport.map((s) => (
          <div class={card}>
            <h3 class="font-black text-[#143844]">{s.title}</h3>
            <p class="mt-2 text-sm leading-7 text-slate-700">{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 10. Discover the appeal: history / architecture / culture / core experience -->
    <section>
      <h2 class={h2}>Discover the appeal of {a.name}</h2>
      <div class="mt-5 space-y-4">
        {a.appeal.map((s, i) => (
          <div class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 card-shadow">
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#143844] text-sm font-black text-white">{i + 1}</span>
            <div>
              <h3 class="font-black text-[#143844]">{s.title}</h3>
              <p class="mt-2 text-sm leading-7 text-slate-700">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 11. Suggested route, numbered steps -->
    <section>
      <h2 class={h2}>Suggested route</h2>
      <p class="mt-3 leading-8">{a.routeIntro}</p>
      <ol class="mt-5 space-y-3">
        {a.route.map((step, i) => (
          <li class="flex gap-4 rounded-2xl bg-[#f8fafc] p-4">
            <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#a66f2d] text-sm font-black text-white">{i + 1}</span>
            <span class="text-sm leading-7 text-slate-700">{step}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- 12. Visitor notes -->
    <Checklist title="Visitor notes — before you go" items={a.notes} />

    <!-- 13. Photo spots -->
    <section>
      <h2 class={h2}>Photo spots</h2>
      <div class="mt-5 space-y-4">
        {a.photoSpots.map((s, i) => (
          <div class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 card-shadow">
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#143844] text-sm font-black text-white">{i + 1}</span>
            <div>
              <h3 class="font-black text-[#143844]">{s.title}</h3>
              <p class="mt-2 text-sm leading-7 text-slate-700">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 14. Where to stay -->
    <section>
      <h2 class={h2}>Where to stay</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {a.stay.map((s) => (
          <div class={card}>
            <h3 class="font-black text-[#143844]">{s.title}</h3>
            <p class="mt-2 text-sm leading-7 text-slate-700">{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 15. Visitor reviews -->
    <section>
      <h2 class={h2}>Visitor reviews</h2>
      <p class="mt-3 leading-8">{a.reviewNote}</p>
      <p class="mt-4"><a class={link} href={map} target="_blank" rel="noopener noreferrer">Read current reviews on Google Maps ↗</a></p>
    </section>

    <!-- 16. Directions: address + map link -->
    <section class="rounded-[2rem] bg-[#143844] p-6 text-white md:p-8">
      <h2 class="text-2xl font-black">Directions &amp; address</h2>
      <p class="mt-3 leading-8 text-white/85">{a.address}</p>
      <p class="mt-2 text-sm leading-7 text-white/70">Use the live map link for the current pin and route.</p>
      <a class="mt-5 inline-block rounded-full bg-[#f2b86d] px-5 py-2.5 text-sm font-bold text-[#143844]" href={map} target="_blank" rel="noopener noreferrer">Open in Google Maps ↗</a>
      <p class="mt-5 text-sm leading-7 text-white/70">Planning from Lake View Park? <a class="underline" href="/nearby-attractions/">See all nearby attractions →</a></p>
    </section>
  </article>
</SubpageLayout>

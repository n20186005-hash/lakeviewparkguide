---
import '../styles/global.css';
import { SITE, park, images, canonicalFor } from '../data/park';
import PhotoCredit from '../components/PhotoCredit.astro';
import FaqSection from '../components/FaqSection.astro';

interface Breadcrumb { name: string; href: string; }
interface Link { label: string; href: string; }
interface FaqItem { q: string; a: string; }

interface Props {
  title: string;
  description: string;
  path: string;
  breadcrumb?: Breadcrumb[];
  image?: string;
  eyebrow?: string;
  related?: Link[];
  lastUpdated?: string;
  faq?: FaqItem[];
}

const {
  title,
  description,
  path,
  breadcrumb = [{ name: 'Home', href: '/' }],
  image = images.hero,
  eyebrow = 'Lake View Park Islamabad guide',
  related = [],
  lastUpdated = park.contentVerified,
  faq = [],
} = Astro.props;

const canonical = canonicalFor(path);
const ogImage = new URL(image, SITE).toString();

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.href, SITE).toString(),
  })),
};

const websiteJson = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  name: `${park.fullName} Islamabad Guide`,
  url: SITE,
  inLanguage: 'en',
};

const pageJson = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical + '#webpage',
  name: title,
  url: canonical,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE}/#website` },
  about: { '@id': `${SITE}/#attraction` },
};

const faqJson = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={`${park.fullName} in ${park.city}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#143844" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Lake View Park" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  <link rel="icon" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJson)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(pageJson)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)}></script>
  {faqJson && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>}
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-HXM22WWPKP');
  </script>
</head>
<body class="paper">
  <header class="sticky top-0 z-30 border-b border-white/10 bg-[#102b33]/95 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
      <a href="/" class="flex items-center gap-2 font-bold text-white"><img src="/logo.svg" alt="" class="h-8 w-8" /><span>Lake View Park Guide</span></a>
      <a href="/" class="text-sm text-white/80 underline">← Home</a>
    </div>
  </header>

  <main id="top">
    <section class="bg-[#143844] px-5 py-12 text-white md:py-16">
      <div class="mx-auto max-w-6xl">
        <nav aria-label="Breadcrumb" class="text-sm text-white/60">
          {breadcrumb.map((b, i) => (
            <span>{i > 0 && <span aria-hidden="true"> › </span>}{i === breadcrumb.length - 1 ? b.name : <a href={b.href} class="underline">{b.name}</a>}</span>
          ))}
        </nav>
        <p class="mt-4 text-sm font-bold text-[#f2b86d]">{eyebrow}</p>
        <h1 class="section-title mt-2 text-4xl font-black leading-tight md:text-5xl">{title}</h1>
        <p class="mt-4 max-w-3xl text-sm text-white/75">Last reviewed {lastUpdated}. This is an independent, noncommercial guide — not the park’s official website. Confirm current gate hours, fees and activity operation with CDA or on-site management before travelling.</p>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-5 py-12 md:py-16">
      <slot />
      {faq.length > 0 && <FaqSection items={faq} />}
    </div>

    {related.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pb-16">
        <h2 class="text-2xl font-black">Related guides</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((l) => (
            <li><a href={l.href} class="block rounded-2xl border border-slate-200 bg-white p-4 text-sm font-semibold text-[#a66f2d] card-shadow transition hover:-translate-y-0.5">{l.label} →</a></li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <footer class="bg-[#102b33] px-5 py-10 text-white/70">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3"><img src="/logo.svg" alt="" class="h-9 w-9" /><b class="text-white">Lake View Park Guide</b></div>
      <p class="max-w-2xl text-sm">An independent, noncommercial visitor guide. It is not the park’s official website. Verify hours, fees and activity availability with CDA or on-site management before you travel.</p>
    </div>
  </footer>

  <script is:inline>
    if ('serviceWorker' in navigator) { window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); }); }
  </script>
</body>
</html>

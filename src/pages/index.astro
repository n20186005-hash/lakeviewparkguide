        <p class="text-sm font-bold text-[#f2b86d]">Sources</p>
        <h2 class="mt-2 text-4xl font-black text-white">References &amp; Data Sources</h2>
        <ul class="mt-8 space-y-5 text-sm leading-7"><li><b>Google Maps · {park.ratingSync}</b><br/>Third-party 4.5 / 5 from 14,939 reviews; not collected by this guide. <a class="underline" href={park.mapsShareUrl}>View the listing</a>.</li><li><a class="underline" href="https://cda.gov.pk/destination">CDA: destinations in Islamabad</a> — park description, not a timetable.</li><li><a class="underline" href={park.cdaUrl}>CDA: Environmental Protection Cell</a> — parks remit and the non-functional walk-in aviary, checked 29 October 2026.</li><li><a class="underline" href="https://www.cda.gov.pk/public/Assets/YEAR_2023/4th-Jul-2023.pdf">CDA board decision, 4 July 2023, page 8</a> — historic basic-entry and parking decision, not current prices.</li><li><a class="underline" href="https://ictadministration.gov.pk/public-places/">ICT Administration: public places</a> · <a class="underline" href="https://www.pmd.gov.pk/">Pakistan Meteorological Department</a> · <a class="underline" href="https://www.cda.gov.pk/cdaTransitMap">CDA transit information</a></li><li>Exact photograph sources, creators, dates and licences appear beside each image. <a class="underline" href="#photo-credit-1">First image credit</a>.</li></ul><h3 id="privacy" class="mt-10 text-2xl font-black text-white">Privacy and purpose</h3><p class="mt-4 text-sm leading-7">This independent noncommercial tourism and cultural guide offers no bookings, tickets or payments. Google Analytics loads to analyse page use; the Google Maps embed connects to Google separately. Cloudflare provides hosting and security and may process connection and technical data. Our server requests Open-Meteo weather for fixed park coordinates; it does not need your location.</p><p lang="ur" dir="rtl" class="ur mt-4 text-sm">یہ آزاد غیر تجارتی سیاحتی معلوماتی رہنما ہے۔ Google Analytics اور Google نقشہ براؤزر سے جڑتے ہیں، جبکہ Cloudflare میزبانی اور حفاظتی ڈیٹا پراسیس کر سکتا ہے۔ موسم کے لیے سرور پارک کے مقررہ نقاط استعمال کرتا ہے؛ آپ کی لوکیشن ضروری نہیں۔</p><p class="mt-4 text-sm"><a class="underline" href="https://policies.google.com/privacy">Google privacy</a> · <a class="underline" href="https://www.cloudflare.com/privacypolicy/">Cloudflare privacy</a> · <a class="underline" href="https://open-meteo.com/en/terms">Open-Meteo terms and privacy</a></p>
      </div>
    </section>
  </main>

  <footer lang="ur" dir="rtl" class="bg-[#102b33] px-5 py-10 text-white/70"><div class="mx-auto flex max-w-6xl flex-col gap-4 md:flex-row md:items-center md:justify-between"><div class="flex items-center gap-3"><img src="/logo.svg" alt="" class="h-9 w-9" /><b class="text-white">لیک ویو پارک گائیڈ</b></div><p class="max-w-2xl text-sm">یہ ایک غیر سرکاری معلوماتی ویب سائٹ ہے؛ اوقات، فیس اور سرگرمیوں کی دستیابی کے لیے روانگی سے پہلے متعلقہ انتظامیہ یا تازہ مقامی معلومات کی تصدیق کریں۔</p></div></footer>

  <script is:inline>
    // Register the PWA service worker (progressive enhancement; harmless if unsupported).
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
    }

    // Live conditions plus plain-language advice (data is served by this site's own server endpoint).
    (function () {
      var DATA = null, selected = 0, cards = [];

      function wmo(code) {
        if (code === 0) return { i: '☀️', t: 'Clear' };
        if (code === 1) return { i: '🌤️', t: 'Mainly clear' };
        if (code === 2) return { i: '⛅', t: 'Partly cloudy' };
        if (code === 3) return { i: '☁️', t: 'Overcast' };
        if (code === 45 || code === 48) return { i: '🌫️', t: 'Fog' };
        if (code === 56 || code === 57) return { i:'🌧️',t:'Freezing drizzle' };
        if (code >= 51 && code <= 55) return { i: '🌦️', t: 'Drizzle' };
        if (code === 61) return { i: '🌦️', t: 'Light rain' };
        if (code === 63) return { i: '🌧️', t: 'Moderate rain' };
        if (code === 65) return { i: '🌧️', t: 'Heavy rain' };
        if (code === 66 || code === 67) return { i: '🌧️', t: 'Freezing rain' };
        if (code >= 71 && code <= 77) return { i: '🌨️', t: 'Snow' };
        if (code === 80) return { i: '🌦️', t: 'Light showers' };
        if (code === 81) return { i: '🌧️', t: 'Showers' };
        if (code === 82) return { i: '🌧️', t: 'Heavy showers' };
        if (code === 85 || code === 86) return { i: '🌨️', t: 'Snow showers' };
        if (code === 95) return { i: '⛈️', t: 'Thunderstorm' };
        if (code >= 96) return { i: '⛈️', t: 'Thunderstorm with hail' };
        return { i: '🌡️', t: 'Unsettled' };
      }

      // Beaufort force from km/h, so wind can be described the way people feel it.
      function bf(kmh) {
        var top = [1, 6, 12, 20, 29, 39, 50, 62, 75, 89, 103, 118];
        for (var i = 0; i < top.length; i++) if (kmh < top[i]) return i;
        return 12;
      }
      function uvWord(u) { return u >= 8 ? 'very high' : u >= 5 ? 'high' : u >= 3 ? 'moderate' : 'low'; }
      function windWord(b) { return b >= 7 ? 'gale' : b >= 5 ? 'strong wind' : b >= 3 ? 'noticeable breeze' : 'light air'; }
      function hm(iso) { var p = (iso || '').split('T')[1]; return p ? p.slice(0, 5) : ''; }
      function dow(iso, i) {
        if (i === 0) return 'Today';
        if (i === 1) return 'Tomorrow';
        var d = new Date(iso + 'T00:00');
        return ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][d.getDay()];
      }
      function n0(v) { return v === null || v === undefined ? 0 : v; }

      // One day of data in, only the advice whose conditions are actually met comes out.
      function advise(o) {
        var alerts = [], wear = [], plan = [], bring = [];
        var pop = n0(o.pop), uv = n0(o.uv);
        // Sustained wind is what you feel all day; gusts are what makes things unsafe.
        var bw = bf(n0(o.wind)), bg = bf(n0(o.gust));

        var rain = 'none';
        if (o.code >= 95) rain = 'thunder';
        else if ([56,57,66,67].indexOf(o.code)>=0) rain = 'freezing';
        else if (o.code >= 51 && o.code <= 55) rain = 'drizzle';
        else if (o.code === 61 || o.code === 80) rain = 'light';
        else if (o.code === 65 || o.code === 82) rain = 'heavy';
        else if (o.code === 63 || o.code === 81) rain = 'moderate';
        else if ((o.code >= 71 && o.code <= 77) || o.code === 85 || o.code === 86) rain = 'snow';

        if (rain === 'thunder') {
          alerts.push({ t: 'Thunderstorm in the forecast', d: 'Lightning risk: leave exposed lakeside areas, stay out of the water and do not shelter under isolated trees. Check PMD warnings and management instructions.' });
          wear.push('Wet and stormy—waterproof shoes and a hooded layer.');
          plan.push('Delay exposed lakeside activities and ask management about access; this forecast does not announce closures.');
          bring.push('A hooded rain jacket, safer than an umbrella in lightning');
        } else if (rain === 'freezing') {
          alerts.push({t:'Freezing rain',d:'Surfaces may ice. Delay slippery routes and check local safety advice.'});
          plan.push('Keep off icy paths; confirm safe access with management.');bring.push('Warm waterproof layers and suitable footwear');
        } else if (rain === 'heavy') {
          alerts.push({ t: 'Heavy rain in the forecast', d: 'Avoid low-lying ground, the dam spillway area and stream beds—water rises fast in a monsoon downpour.' });
          wear.push('Wet day—waterproof shoes and quick-drying clothes.');
          plan.push('Shorten or postpone outdoor plans and confirm actual access with management.');
          bring.push('A rain jacket rather than a long umbrella');
        } else if (pop >= 60) {
          wear.push('Rain is likely, around ' + pop + '% chance—carry a rain layer.');
          plan.push('Keep a sheltered alternative in mind; open-air activities are less pleasant in the wet.');
          bring.push('Folding umbrella');
        } else if (rain === 'light' || rain === 'moderate') {
          wear.push('Showers around—paths and stone steps turn slippery, watch your footing.');
          bring.push('Folding umbrella');
        } else if (rain === 'drizzle') {
          wear.push('Drizzle—surfaces get slick, take care along the lakeside path.');
          plan.push('Drizzle rarely ruins a visit: fine for a walk, poor for distant views and photos.');
          bring.push('Compact umbrella');
        } else if (rain === 'snow') {
          alerts.push({ t: 'Snow or sleet in the forecast', d: 'Surfaces turn slick; the lakeside path and any sloped ground need extra care.' });
          plan.push('Expect a changed park: slippery paths—confirm safe access with management.');
          bring.push('Warm, waterproof shoes');
        }

        if (o.tmax >= 32) {
          wear.push('Hot day, up to ' + Math.round(o.tmax) + '°C—light, breathable clothing.');
          plan.push('Keep outdoor time short and stay out of the midday sun.');
          bring.push('Plenty of drinking water');
        }
        if (uv >= 5) {
          wear.push(uv >= 8 ? 'UV is very strong—cover up rather than bake.' : 'UV is strong—sun protection is worth it.');
          bring.push('Sunscreen, sunglasses, a sun hat');
        }
        if (o.tmax <= 10) {
          wear.push('Cold day—dress warm in layers.');
          bring.push('Warm coat, scarf');
        }
        if (o.tmax - o.tmin > 8) {
          wear.push('Big day-to-night swing, ' + Math.round(o.tmin) + '° to ' + Math.round(o.tmax) + '°C—bring an extra layer for the evening.');
        }
        if (n0(o.humidity) >= 75 && o.tmax >= 28) wear.push('Muggy rather than simply hot—loose fabrics feel far better.');

        if (bw >= 7 || bg >= 7) {
          alerts.push({ t: 'Strong wind, gusts to force ' + Math.max(bw, bg), d: 'Stay clear of loose structures and the exposed lakeshore; check management instructions for each activity.' });
          wear.push('Very windy—secure layers, and leave loose accessories behind.');
          plan.push('Avoid exposed water-edge routes in strong wind; the operator determines actual activity status.');
        } else if (bw >= 5 || bg >= 6) {
          wear.push('Windy—a wind-resistant layer helps.');
          plan.push('Ask the operator about wind limits and current activity availability.');
          bring.push('A hat that stays on; loose, flowing clothes are a nuisance in wind');
        }

        if (o.code === 45 || o.code === 48) {
          alerts.push({ t: 'Fog', d: 'Poor visibility—take extra care on the dam approach road, and assess whether views are clear on arrival.' });
          wear.push('Murky and damp—a light layer you can shed once it clears.');
          plan.push('Shorten unfamiliar routes when visibility is poor and assess the view on arrival.');
          bring.push('A mask if haze bothers you');
        }

        if (o.code === 0 || o.code === 1) plan.push('Clear conditions may suit lake views, subject to the rain chance and confirmed gate hours.');
        else if (o.code === 2 || o.code === 3) plan.push('Cloud cover alone does not establish comfortable conditions; also check temperature, wind and rain probability.');

        if (!alerts.length && rain === 'none' && pop < 60 && bw <= 4 && bg <= 5 && o.tmax >= 18 && o.tmax <= 34) {
          plan.push('If management confirms safe access, consider a lakeside walk. The forecast does not confirm boating operation.');
        }

        if (!wear.length) wear.push('Comfortable conditions—dress for the season and you will be fine.');
        if (!plan.length) {
          plan.push(alerts.length
            ? 'Keep the plan flexible and check conditions locally before you go.'
            : 'No additional advice is triggered by these model fields; still check PMD warnings and management access.');
        }
        if (!bring.length) bring.push('Nothing special; water and sun protection as usual.');

        return {
          alerts: alerts,
          wear: wear,
          plan: plan,
          bring: bring,
          umbrella: ['thunder','freezing','heavy','moderate','light','drizzle'].indexOf(rain)>=0 || pop>=60
        };
      }

      function dayAt(i) {
        var d = DATA.daily;
        return {
          code: d.weather_code[i],
          tmax: d.temperature_2m_max[i],
          tmin: d.temperature_2m_min[i],
          pop: d.precipitation_probability_max ? d.precipitation_probability_max[i] : null,
          psum: d.precipitation_sum ? d.precipitation_sum[i] : null,
          wind: d.wind_speed_10m_max ? d.wind_speed_10m_max[i] : null,
          gust: d.wind_gusts_10m_max ? d.wind_gusts_10m_max[i] : null,
          uv: d.uv_index_max ? d.uv_index_max[i] : null,
          humidity: DATA.current ? DATA.current.relative_humidity_2m : null
        };
      }

      function renderNow() {
        var c = DATA.current, d = DATA.daily, k = wmo(c.weather_code);
        var pop = d.precipitation_probability_max ? d.precipitation_probability_max[0] : null;
        var uv = d.uv_index_max ? d.uv_index_max[0] : null;
        var el = document.getElementById('weather-now');
        el.className = 'mt-6 rounded-[2rem] card-shadow bg-white p-8';
        el.innerHTML =
          '<div class="flex flex-wrap items-center justify-between gap-6">' +
            '<div class="flex items-center gap-5">' +
              '<div class="text-6xl">' + k.i + '</div>' +
              '<div><div class="text-5xl font-black text-[#143844]">' + Math.round(c.temperature_2m) + '°C</div>' +
              '<div class="text-slate-500">' + k.t + ' · feels like ' + Math.round(c.apparent_temperature) + '°C</div></div>' +
            '</div>' +
            '<div class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm text-slate-600">' +
              '<div>Model precipitation: <b>' + (n0(c.precipitation) > 0 ? 'yes' : 'no') + '</b></div>' +
              '<div>Chance today: <b>' + (pop === null ? '—' : pop + '%') + '</b></div>' +
              '<div>Wind: <b>' + Math.round(c.wind_speed_10m) + ' km/h</b>' + (c.wind_gusts_10m ? ', gusts ' + Math.round(c.wind_gusts_10m) : '') + '</div>' +
              '<div>UV today: <b>' + (uv === null ? '—' : uvWord(uv)) + '</b></div>' +
            '</div>' +
          '</div>';
      }

      function renderAdvice() {
        var d = DATA.daily, o = dayAt(selected), a = advise(o), k = wmo(o.code);

        var al = document.getElementById('weather-alerts');
        al.innerHTML = a.alerts.length
          ? '<div class="rounded-2xl border-l-4 border-[#b3261e] bg-[#fdecea] p-5">' +
              '<p class="text-sm font-black text-[#b3261e]">⚠️ Risk alerts — ' + dow(d.time[selected], selected) + '</p>' +
              a.alerts.map(function (x) { return '<p class="mt-2 text-sm text-[#7a1c16]"><b>' + x.t + '.</b> ' + x.d + '</p>'; }).join('') +
            '</div>'
          : '';

        var head =
          '<div class="flex flex-wrap items-center gap-3 rounded-2xl bg-white p-5 card-shadow">' +
            '<p class="text-sm font-black text-[#143844]">' + dow(d.time[selected], selected) + ' · ' + k.i + ' ' + k.t + ' · ' +
              Math.round(o.tmin) + '–' + Math.round(o.tmax) + '°C · UV ' + uvWord(n0(o.uv)) + ' · ' +
              windWord(bf(n0(o.wind))) + (bf(n0(o.gust)) > bf(n0(o.wind)) ? ', gusts to force ' + bf(n0(o.gust)) : '') + '</p>' +
            '<span class="rounded-full px-3 py-1 text-xs font-bold ' + (a.umbrella ? 'bg-[#143844] text-white' : 'bg-[#ece3cf] text-[#5b4a2f]') + '">' +
              (a.umbrella ? '☂️ Plan rain protection' : 'No rain-gear trigger in this forecast') + '</span>' +
          '</div>';

        var block = function (icon, title, items) {
          if (!items.length) return '';
          return '<div class="rounded-2xl bg-white p-5 card-shadow">' +
            '<p class="text-sm font-black text-[#143844]">' + icon + ' ' + title + '</p>' +
            '<ul class="mt-2 space-y-1 text-sm text-slate-600">' +
            items.map(function (t) { return '<li>· ' + t + '</li>'; }).join('') +
            '</ul></div>';
        };

        document.getElementById('weather-advice').innerHTML = head +
          '<div class="mt-4 grid gap-4 md:grid-cols-3">' +
            block('✅', 'What to wear', a.wear) +
            block('🗺️', 'How to plan', a.plan) +
            block('🎒', 'What to bring', a.bring) +
          '</div>';
      }

      function renderDays() {
        var d = DATA.daily, wrap = document.getElementById('weather-days');
        wrap.innerHTML = '';
        cards = [];
        for (var i = 0; i < d.time.length; i++) {
          (function (i) {
            var o = dayAt(i), a = advise(o), k = wmo(o.code);
            var card = document.createElement('button');
            card.type = 'button';
            card.className = 'w-full rounded-2xl bg-white p-4 text-center card-shadow transition hover:-translate-y-0.5' +
              (i === selected ? ' ring-2 ring-[#143844]' : '');
            card.innerHTML =
              '<div class="text-xs font-bold text-slate-400">' + dow(d.time[i], i) + '</div>' +
              '<div class="my-2 text-3xl">' + k.i + '</div>' +
              '<div class="text-sm font-black text-[#143844]">' + Math.round(o.tmax) + '° / ' + Math.round(o.tmin) + '°</div>' +
              '<div class="mt-1 text-xs text-slate-500">💧 ' + (o.pop === null ? '—' : o.pop + '%') + '</div>' +
              '<div class="mt-1 text-xs">' +
                (a.alerts.length ? '<span class="font-bold text-[#b3261e]">⚠️ risk</span>' : (a.umbrella ? '☂️' : '✅')) +
              '</div>';
            card.addEventListener('click', function () {
              selected = i;
              for (var j = 0; j < cards.length; j++) {
                if (j === i) { cards[j].classList.add('ring-2'); cards[j].classList.add('ring-[#143844]'); }
                else { cards[j].classList.remove('ring-2'); cards[j].classList.remove('ring-[#143844]'); }
              }
              renderAdvice();
            });
            cards.push(card);
            wrap.appendChild(card);
          })(i);
        }
      }

      fetch('/api/weather')
        .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function (data) {
          DATA = data;
          renderNow();
          renderDays();
          renderAdvice();
          var up = document.getElementById('weather-updated');
          if(up)up.textContent='Model time '+data.current.time.replace('T',' ')+' · Fetched '+new Date(data.guide.fetchedAt).toLocaleString('en-GB',{timeZone:'Asia/Karachi',hour12:false})+' · '+Math.max(0,Math.floor((Date.now()-Date.parse(data.guide.fetchedAt))/60000))+' minutes since fetch · Sunrise '+hm(data.daily.sunrise[0])+' · Sunset '+hm(data.daily.sunset[0])+' (Pakistan Standard Time)';
        })
        .catch(function () {
          var n = document.getElementById('weather-now');
          if (n) { n.className = 'mt-6 rounded-[2rem] card-shadow bg-white p-8 text-slate-500'; n.textContent = 'Weather information is temporarily unavailable. Please check again shortly.'; }
        });
    })();
  </script>
</body>
</html>

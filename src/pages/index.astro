---
import '../styles/global.css';
import PhotoCredit from '../components/PhotoCredit.astro';

// ── Single source of truth: SEO entity binding variables ──────────────
const DOMAIN = 'lakeviewparkguide.com';
const SITE = `https://${DOMAIN}`;
const canonical = new URL(Astro.url.pathname || '/', SITE).toString();

const park = {
  fullName: 'Lake View Park',
  shortName: 'Lake View Park',
  city: 'Islamabad',
  region: 'Islamabad Capital Territory',
  country: 'Pakistan',
  countryCode: 'PK',
  plusCode: 'P47J+39P',
  street: 'Murree Road',
  lat: 33.71494,
  lng: 73.13281,
  rating: 4.5,
  reviewCount: 14939,
  category: 'Park',
  mapsShareUrl: 'https://maps.app.goo.gl/6Jch5oC2zebDATyq9',
  mapsEmbed: 'https://www.google.com/maps?q=P47J%2B39P%2C%20Murree%20Rd%2C%20Lake%20View%20Park%2C%20Islamabad%2C%20Pakistan&output=embed&hl=ur',
  govtTourismUrl: 'https://tourism.gov.pk/',
  cdaUrl: 'https://www.cda.gov.pk/environmentalProtectionCell',
  pmdUrl: 'https://www.pmd.gov.pk/',
  ratingSync: '29 October 2026',
};

const heroImg = '/images/lake-view-park-rawal-lake.jpg';
const lakeImg = '/images/rawal-lake-islamabad.jpg';
const galleryImg = '/images/rawal-lake-islamabad-view.jpg';
const heroAlt = `${park.fullName} - Main view in ${park.city}, ${park.country}`;

// Structured data — reviews are intentionally NOT included here (they live on the
// page only, attributed to Google Maps) to avoid misrepresenting third-party ratings.
const attractionJson = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${SITE}/#attraction`,
  name: park.fullName,
  alternateName: [
    park.shortName,
    `${park.city} ${park.fullName}`,
    `${park.fullName} Islamabad`,
    'لیک ویو پارک'
  ],
  description: `Comprehensive visitor guide to ${park.fullName} in ${park.city}, ${park.region}, ${park.country}.`,
  url: SITE,
  image: [`${SITE}${heroImg}`],
  address: {
    '@type': 'PostalAddress',
    streetAddress: park.street,
    addressLocality: park.city,
    addressRegion: park.region,
    addressCountry: park.countryCode
  },
  geo: { '@type': 'GeoCoordinates', latitude: park.lat, longitude: park.lng },
  hasMap: park.mapsShareUrl,
  sameAs: [park.mapsShareUrl, 'https://cda.gov.pk/destination']
};

const pageJson = {'@context':'https://schema.org','@type':'WebPage',name:'Lake View Park Islamabad visitor guide',url:SITE+'/',inLanguage:['en','ur'],about:{'@id':SITE+'/#attraction'}};
const currentHoursEn='Current gate and last-entry times have not been confirmed from CDA. Google Maps showed a 10:00 opening on 29 October 2026, but this does not establish an official weekly schedule or closing time. Confirm with CDA before travelling; activities may have separate hours.';
const feeEn='CDA’s 4 July 2023 board decision stated no basic park entry fee and approved outsourcing parking-fee collection. That is dated policy evidence, not a verified 2026 tariff. Confirm today’s entry, parking and individual activity charges separately.';
const aviaryEn='CDA’s Environmental Protection Cell page lists the Lakeview Park walk-in aviary as presently non-functional (checked 29 October 2026). Do not plan an aviary visit unless CDA confirms a change. The wider park and separately operated activities have their own access conditions.';
const faqUr = [
  ['کیا پارک میں داخلہ فیس ہے؟', 'CDA کے ۴ جولائی ۲۰۲۳ کے فیصلے میں بنیادی داخلہ فیس نہ لینے اور پارکنگ فیس کی وصولی آؤٹ سورس کرنے کا ذکر ہے۔ یہ تاریخی فیصلہ ہے، موجودہ ۲۰۲۶ کا نرخ نامہ نہیں۔ روانگی سے پہلے داخلہ، پارکنگ اور سرگرمیوں کے تازہ اخراجات الگ پوچھیں۔'],
  ['پارک کے موجودہ اوقات کیا ہیں؟','CDA سے موجودہ گیٹ اور آخری داخلے کے اوقات کی تصدیق نہیں ہوئی۔ ۲۹ اکتوبر ۲۰۲۶ کو Google Maps پر صبح دس بجے کھلنے کا اشارہ تھا، مگر یہ سرکاری ہفتہ وار شیڈول یا بندش کا وقت ثابت نہیں کرتا۔'],
  ['کیا ایویری کھلی ہے؟','۲۹ اکتوبر ۲۰۲۶ کو دیکھی گئی CDA کی ماحولیاتی ویب سائٹ پر واک اِن ایویری غیر فعال درج ہے۔ انتظامیہ کی نئی تصدیق کے بغیر ایویری کی سیر کا منصوبہ نہ بنائیں۔'],
  ['بہترین وقت کب ہے؟', 'پرسکون ماحول کے لیے ہفتے کے دن صبح یا دوپہر سے پہلے بہتر رہتے ہیں۔ شام جھیل اور غروبِ آفتاب کے نظاروں کے لیے خوبصورت ہوتی ہے مگر ہجوم بڑھ سکتا ہے۔'],
  ['کتنا وقت رکھنا چاہیے؟', 'عام سیر، واک اور جھیل کے نظارے کے لیے تقریباً ⁦2–3⁩ گھنٹے مناسب ہیں؛ بچوں کی سرگرمیوں یا پکنک کے ساتھ آدھا دن رکھیں۔'],
  ['پارکنگ دستیاب ہے؟', 'ہاں، پارک میں گاڑیوں کے لیے پارکنگ موجود ہے۔ مصروف اختتامِ ہفتہ اور سرکاری تعطیلات میں جلد پہنچنا بہتر ہے۔'],
  ['کیا کشتی رانی ہمیشہ دستیاب ہوتی ہے؟', 'کشتی رانی اور پانی کی سرگرمیاں انتظامی یا موسمی پابندیوں کے تابع ہو سکتی ہیں؛ خاص طور پر اسی مقصد سے جانے سے پہلے موجودہ صورتحال چیک کریں۔']
];

const faqEn = [
  ['Where is Lake View Park located?', `${park.fullName} sits on Murree Road in ${park.city}, ${park.region}, ${park.country}, on the shore of Rawal Lake. The Plus Code is ${park.plusCode}.`],
  ['Is Lake View Park free to visit?', feeEn],
  ['What are the best times to visit?', 'Weekday mornings and early afternoons are calmer. Evenings are lovely for lake and sunset views but busier. Avoid peak weekends and public holidays if you prefer smaller crowds.'],
  ['How do I get to Lake View Park?', 'By car or rideshare, follow Murree Road toward the Rawal Dam / Lake View Park signs; the Plus Code works in map apps. Use CDA’s current transit information to check the actual route, stop and onward walk; no direct bus service is guaranteed here.'],
  ['Is boating available all year?', 'Boating and water activities depend on management and seasonal or weather conditions; check the current status before making a special trip.'],
  ['How much time should I plan for?', 'About ⁦2–3⁩ hours for a walk and lake view; allow half a day if you add a picnic, children’s activities, or nearby viewpoints.'],
  ['What are the Lake View Park timings?', currentHoursEn],
  ['What is the entry ticket price?', feeEn],
  ['Can I bring outside food?', 'Many visitors bring their own snacks and picnic items for the lawns. On-site food stalls and tea shops also operate inside and around the park. Follow CDA rules and use the bins to keep the lawns clean.'],
  ['Is there a bird park or aviary?', aviaryEn],
  ['What are the main attractions?', 'Highlights include the open lakefront and viewpoints over Rawal Lake, boating when available, children’s play areas, green lawns for picnics, CDA-described food stalls; the aviary is currently listed as non-functional — a full family-outing list is in the park directory below.']
];

const faqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [...faqUr.map(([q,a])=>({q,a,lang:'ur'})),...faqEn.map(([q,a])=>({q,a,lang:'en'}))].map(({q,a,lang}) => ({
    '@type': 'Question',
    name: q,
    inLanguage: lang,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Lake View Park Islamabad | Hours, Entry Fees &amp; Aviary Status</title>
  <meta name="description" content={`Plan your visit to ${park.fullName} (Rawal Lake) in ${park.city}, ${park.country}. Confirm current gate hours and fees with CDA, check the aviary status, find Murree Road directions and read the weather forecast.`} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${park.fullName} Islamabad — Hours, Fees & Aviary Status`} />
  <meta property="og:description" content={`Visitor guide to ${park.fullName} (Rawal Lake), ${park.city}: CDA access information, dated fee-policy evidence, aviary status, directions and weather.`} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={SITE} />
  <meta property="og:image" content={`${SITE}${heroImg}`} />
  <meta property="og:image:alt" content={`${park.fullName} in ${park.city}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#143844" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Lake View Park" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  <link rel="icon" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionJson)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(pageJson)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-HXM22WWPKP');
  </script>
</head>
<body class="paper">
  <header lang="ur" dir="rtl" class="absolute inset-x-0 top-0 z-20 px-5 py-5 text-white">
    <div class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-white/20 bg-black/15 px-5 py-3 backdrop-blur-md">
      <a href="#top" class="flex items-center gap-3 font-bold"><img src="/logo.svg" alt="" class="h-10 w-10" /><span>لیک ویو پارک</span></a>
      <nav class="hidden gap-5 text-sm lg:flex" aria-label="مرکزی فہرست">
        <a href="#about">تعارف</a>
        <a href="#transport">آمدورفت</a>
        <a href="#weather">موسم</a>
        <a href="#nearby">قریب کیا ہے</a>
        <a href="#faq">سوالات</a>
      </nav>
      <details class="mobile-menu lg:hidden"><summary>فہرست</summary><nav aria-label="موبائل فہرست">{[['آمدورفت','transport'],['موسم','weather'],['سوالات','faq'],['English FAQ','faq-en'],['ماخذ','sources']].map(([label,id])=><a href={'#'+id}>{label}</a>)}</nav></details>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero-photo relative min-h-[90vh] overflow-hidden text-white">
      <img src={heroImg} width="4608" height="2592" fetchpriority="high" alt={heroAlt} class="absolute inset-0 h-full w-full object-cover" loading="eager" />
      <div class="absolute inset-0" style="background-image: linear-gradient(100deg, rgba(6,24,29,.86), rgba(6,24,29,.25))"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#102b33] via-transparent to-transparent"></div>
      <div class="relative mx-auto flex min-h-[90vh] max-w-6xl items-end px-5 pb-16 pt-32 md:pb-24">
        <div class="max-w-3xl">
          <div lang="ur" dir="rtl" class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-sm">راول جھیل • مری روڈ • اسلام آباد</div>
          <h1 class="section-title text-5xl font-black leading-[1.1] md:text-7xl">Lake View Park, Islamabad<span lang="ur" dir="rtl" class="mt-3 block text-2xl font-bold text-[#f3be72] md:text-3xl">لیک ویو پارک اسلام آباد · Rawal Lake</span></h1>
          <p class="mt-6 max-w-2xl text-lg leading-9 text-white/85">Plan time by Rawal Lake, walking paths and family spaces described by CDA. Confirm current gate hours, fees and activity operation before travelling; CDA currently lists the walk-in aviary as non-functional.</p>
          <div lang="ur" dir="rtl" class="mt-8 flex flex-wrap gap-3">
            <a href="#plan" class="rounded-full bg-[#e5a04c] px-6 py-3 font-bold text-[#17333c]">سیر کی تیاری کریں</a>
            <a href={park.mapsShareUrl} class="rounded-full border border-white/35 bg-white/10 px-6 py-3" target="_blank" rel="noopener noreferrer">گوگل میپس کھولیں ↗</a>
          </div>
        </div>
      </div>
      <div class="relative mx-auto max-w-6xl bg-[#102b33] px-5 py-4"><PhotoCredit photo={1} dark /></div>
    </section>

    <!-- QUICK STATS -->
    <section lang="ur" dir="rtl" class="ur mx-auto mt-8 grid max-w-6xl gap-4 px-5 md:grid-cols-4">
      {[
        ['اوقات','CDA سے تازہ وقت پوچھیں'],
        ['داخلہ','موجودہ فیس کی تصدیق کریں'],
        ['درجہ بندی', `${park.rating} / 5`],
        ['مدت','⁦2–3⁩ hours / half-day']
      ].map(([k,v]) => <div class="card-shadow rounded-3xl bg-white p-6"><div class="text-xs font-bold text-[#7c6c51]">{k}</div><div class="mt-2 text-lg font-black">{k==='درجہ بندی'||k==='مدت'?<bdi lang="en" dir="ltr">{v}</bdi>:v}</div></div>)}
    </section>

    <section lang="en" dir="ltr" id="access" class="en mx-auto max-w-6xl px-5 py-12"><div class="rounded-3xl border border-[#dba15c] bg-white p-7"><h2 class="text-2xl font-black">Before you travel: hours, fees and the aviary</h2><p class="mt-4">{currentHoursEn}</p><p class="mt-4">{feeEn}</p><p class="mt-4">{aviaryEn}</p><p class="mt-5"><a class="underline" href={park.cdaUrl}>CDA parks and aviary information</a> · <a class="underline" href="https://www.cda.gov.pk/public/Assets/YEAR_2023/4th-Jul-2023.pdf">4 July 2023 board decision, page 8</a></p><p lang="ur" dir="rtl" class="ur mt-5">روانگی سے پہلے CDA سے موجودہ اوقات اور اخراجات کی تصدیق کریں۔ CDA کی ویب سائٹ پر ایویری غیر فعال درج ہے؛ پرانی تصویریں یا تاریخی فیس کا فیصلہ موجودہ دستیابی کی ضمانت نہیں۔ معلومات دیکھی گئیں: ۲۹ اکتوبر ۲۰۲۶۔</p></div></section>

    <!-- GOOGLE REVIEWS (display only — not in JSON-LD) -->
    <section id="reviews" class="mx-auto max-w-6xl px-5 py-16">
      <div class="rounded-[2rem] card-shadow bg-white p-8 md:p-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <div class="flex items-center gap-3">
              <span class="text-5xl font-black text-[#143844]">{park.rating}</span>
              <span class="text-2xl text-amber-500">★★★★★</span>
            </div>
            <div class="mt-1 text-sm text-slate-500">{park.category} · {park.reviewCount.toLocaleString('en-US')} Google Maps reviews</div>
          </div>
          <a href={park.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#e5a04c] px-6 py-3 font-bold text-[#17333c]">View all Google Maps reviews ↗</a>
        </div>
        <p class="mt-6 text-xs leading-6 text-slate-500">Third-party Google Maps snapshot · {park.ratingSync} · Not reviews collected by this guide.</p>
        <p class="mt-2 text-xs leading-6 text-slate-500">Counts can change; this page does not automatically synchronize with Google Maps.</p>
      </div>
    </section>

    <!-- URDU INTRO -->
    <section lang="ur" dir="rtl" class="ur mx-auto grid max-w-6xl gap-10 px-5 py-20 md:grid-cols-[1.05fr_.95fr] md:items-center">
      <div><p class="text-sm font-bold text-[#a66f2d]">راول جھیل کی فضا</p><h2 class="section-title mt-2 text-4xl font-black leading-[1.5]">یہاں اصل کشش "کرنے" سے زیادہ "ٹھہرنے" میں ہے</h2><p class="mt-5 text-lg text-slate-700">CDA کے مطابق پارک راول جھیل کے کنارے تفریح، واک، بچوں کے کھیل اور مقامی فوڈ اسٹالز کا مرکز ہے۔ کشتی رانی یا مخصوص سرگرمیوں کی دستیابی وقت اور انتظامی پابندیوں کے ساتھ بدل سکتی ہے، اس لیے انہیں یقینی سمجھ کر نہ جائیں۔</p></div>
      <figure><img src={lakeImg} width="1280" height="960" alt={`Historic Rawal Lake view from ${park.fullName}`} class="h-[420px] w-full rounded-[2rem] object-cover card-shadow" loading="lazy" /><figcaption><PhotoCredit photo={2} /></figcaption></figure>
    </section>

    <!-- PLAN (Urdu) -->
    <section id="plan" lang="ur" dir="rtl" class="ur bg-[#143844] py-20 text-white">
      <div class="mx-auto max-w-6xl px-5"><p class="text-sm font-bold text-[#f2b86d]">سیر کا منصوبہ</p><h2 class="mt-2 text-4xl font-black">جانے سے پہلے یہ جان لیں</h2><div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">🎟️ ٹکٹ / اخراجات</h3><p class="mt-3 text-white/75">CDA کے ۴ جولائی ۲۰۲۳ کے فیصلے میں بنیادی داخلہ فیس نہ لینے کا ذکر ہے؛ اسے ۲۰۲۶ کا مصدقہ نرخ نامہ نہ سمجھیں۔ آج کے داخلے، پارکنگ اور سرگرمیوں کی قیمت الگ پوچھیں۔</p></article>
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">🚗 پارکنگ</h3><p class="mt-3 text-white/75">پارکنگ موجود ہے اور CDA نے پارکنگ فیس کی وصولی آؤٹ سورس کرنے کی منظوری دی تھی۔ اختتامِ ہفتہ جلد پہنچنا بہتر ہے۔</p></article>
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">🌤️ بہترین وقت</h3><p class="mt-3 text-white/75">ہفتے کے دن نسبتاً پرسکون؛ شام روشنی اور جھیل کے منظر کے لیے عمدہ۔ گرمی میں دوپہر کے بجائے صبح یا شام کو ترجیح دیں۔</p></article>
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">⏱️ قیام کی مدت</h3><p class="mt-3 text-white/75">صرف واک اور جھیل کے لیے ⁦2–3⁩ گھنٹے؛ پکنک، بچوں کے کھیل یا متعدد سرگرمیوں کے لیے آدھا دن رکھیں۔</p></article>
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">👟 ساتھ کیا لائیں</h3><p class="mt-3 text-white/75">آرام دہ جوتے، پانی، دھوپ سے بچاؤ اور مچھر بھگانے والی چیز کام آ سکتی ہے۔ پکنک کے لیے چادر یا میٹ مفید ہے۔</p></article>
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">🛶 سرگرمیاں</h3><p class="mt-3 text-white/75">CDA واک، بچوں کے کھیل اور جھیل کی سرگرمیوں کا تعارف دیتا ہے، مگر ہر سہولت کی موجودہ حالت الگ پوچھیں۔ ایویری سرکاری ویب سائٹ پر غیر فعال درج ہے۔</p></article>
      </div></div>
    </section>

    <!-- ABOUT (English / SEO entity binding) -->
    <section lang="en" dir="ltr" id="about" class="en mx-auto max-w-6xl px-5 py-20">
      <p class="text-sm font-bold text-[#a66f2d]">About</p>
      <h2 class="mt-2 text-4xl font-black">About {park.fullName}</h2>
      <p class="mt-5 max-w-3xl text-lg text-slate-700">
        Welcome to <strong>{park.fullName}</strong>, widely recognized as the central <strong>{park.shortName}</strong>. Located in the heart of <strong>{park.city}</strong>, <strong>{park.region}</strong>, <strong>{park.country}</strong>, this lakeside destination serves as a primary hub for travelers visiting the Rawal Lake area.
      </p>
      <nav aria-label="Breadcrumb" class="mt-6 inline-flex flex-wrap items-center gap-2 rounded-full bg-[#ece3cf] px-5 py-2 text-sm text-[#5b4a2f]">
        <span>{park.fullName}</span><span aria-hidden="true">→</span>

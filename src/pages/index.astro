---
import '../styles/global.css';

// ── Single source of truth: SEO entity binding variables ──────────────
const DOMAIN = 'lakeviewparkguide.com';
const SITE = `https://${DOMAIN}`;
const canonical = new URL(Astro.url.pathname || '/', SITE).toString();

const park = {
  fullName: 'Lake View Park',
  shortName: 'Lake View Park',
  city: 'Islamabad',
  region: 'Islamabad Capital Territory',
  country: 'Pakistan',
  countryCode: 'PK',
  postal: '49510',
  plusCode: 'P47J+39P',
  street: 'P47J+39P, Murree Rd, LAKE VIEW PARK',
  lat: 33.71494,
  lng: 73.13281,
  rating: 4.5,
  reviewCount: 14911,
  category: '公园 · Park',
  mapsShareUrl: 'https://maps.app.goo.gl/6Jch5oC2zebDATyq9',
  mapsEmbed: 'https://www.google.com/maps?q=P47J%2B39P%2C%20Murree%20Rd%2C%20Lake%20View%20Park%2C%20Islamabad%2C%20Pakistan&output=embed&hl=ur',
  govtTourismUrl: 'https://tourism.gov.pk/',
  cdaUrl: 'https://www.cda.gov.pk/',
  pmdUrl: 'https://www.pmd.gov.pk/',
  ratingSync: '2026 年 9 月',
};

const heroImg = '/images/lake-view-park-rawal-lake.jpg';
const lakeImg = '/images/rawal-lake-islamabad.jpg';
const galleryImg = '/images/rawal-lake-islamabad-view.jpg';
const heroAlt = `${park.fullName} - Main view in ${park.city}, ${park.country}`;

const hours = ['Mo','Tu','We','Th','Fr','Sa','Su'].map(day => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: day,
  opens: '10:00',
  closes: '22:00'
}));

// Structured data — reviews are intentionally NOT included here (they live on the
// page only, attributed to Google Maps) to avoid misrepresenting third-party ratings.
const attractionJson = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${SITE}/#attraction`,
  name: park.fullName,
  alternateName: [
    park.shortName,
    `${park.city} ${park.fullName}`,
    `${park.fullName} Islamabad`,
    'لیک ویو پارک'
  ],
  description: `Comprehensive visitor guide to ${park.fullName} in ${park.city}, ${park.region}, ${park.country}.`,
  url: SITE,
  image: [`${SITE}${heroImg}`],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: park.street,
    addressLocality: park.city,
    addressRegion: park.region,
    postalCode: park.postal,
    addressCountry: park.countryCode
  },
  geo: { '@type': 'GeoCoordinates', latitude: park.lat, longitude: park.lng },
  openingHoursSpecification: hours,
  hasMap: park.mapsShareUrl,
  sameAs: [park.mapsShareUrl, park.govtTourismUrl, park.cdaUrl]
};

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { position: 1, '@type': 'ListItem', name: park.country, item: SITE + '/#' },
    { position: 2, '@type': 'ListItem', name: park.region, item: SITE + '/#' },
    { position: 3, '@type': 'ListItem', name: park.city, item: SITE + '/#' },
    { position: 4, '@type': 'ListItem', name: park.fullName, item: SITE + '/#attraction' }
  ]
};

const faqUr = [
  ['کیا پارک میں داخلہ فیس ہے؟', 'CDA کے فیصلے کے مطابق بنیادی پارک داخلہ مفت ہے۔ پارکنگ، رائیڈز، ایویری یا دوسری سرگرمیوں کے الگ چارجز ہو سکتے ہیں۔'],
  ['بہترین وقت کب ہے؟', 'پرسکون ماحول کے لیے ہفتے کے دن صبح یا دوپہر سے پہلے بہتر رہتے ہیں۔ شام جھیل اور غروبِ آفتاب کے نظاروں کے لیے خوبصورت ہوتی ہے مگر ہجوم بڑھ سکتا ہے۔'],
  ['کتنا وقت رکھنا چاہیے؟', 'عام سیر، واک اور جھیل کے نظارے کے لیے تقریباً 2–3 گھنٹے مناسب ہیں؛ بچوں کی سرگرمیوں یا پکنک کے ساتھ آدھا دن رکھیں۔'],
  ['پارکنگ دستیاب ہے؟', 'ہاں، پارک میں گاڑیوں کے لیے پارکنگ موجود ہے۔ مصروف اختتامِ ہفتہ اور سرکاری تعطیلات میں جلد پہنچنا بہتر ہے۔'],
  ['کیا کشتی رانی ہمیشہ دستیاب ہوتی ہے؟', 'کشتی رانی اور پانی کی سرگرمیاں انتظامی یا موسمی پابندیوں کے تابع ہو سکتی ہیں؛ خاص طور پر اسی مقصد سے جانے سے پہلے موجودہ صورتحال چیک کریں۔']
];

const faqEn = [
  ['Where is Lake View Park located?', `${park.fullName} sits on Murree Road in ${park.city}, ${park.region}, ${park.country}, on the shore of Rawal Lake. The Plus Code is ${park.plusCode}.`],
  ['Is Lake View Park free to visit?', `${park.fullName} is a public park; basic entry is generally free. Parking, rides, the aviary and some activities may carry separate charges set by the managing authority (CDA).`],
  ['What are the best times to visit?', 'Weekday mornings and early afternoons are calmer. Evenings are lovely for lake and sunset views but busier. Avoid peak weekends and public holidays if you prefer smaller crowds.'],
  ['How do I get to Lake View Park?', 'By car or rideshare, follow Murree Road toward the Rawal Dam / Lake View Park signs; the Plus Code works in map apps. CDA bus routes serve the area—confirm current schedules before travel.'],
  ['Is boating available all year?', 'Boating and water activities depend on management and seasonal or weather conditions; check the current status before making a special trip.'],
  ['How much time should I plan for?', 'About 2–3 hours for a walk and lake view; allow half a day if you add a picnic, children’s activities, or nearby viewpoints.'],
  ['What are the Lake View Park timings?', `${park.fullName} generally opens daily, with the most commonly listed visitor window around 10:00 in the morning to 22:00 at night. Hours are set by the managing authority (CDA) and can change by season or event, so confirm the current timings before a special trip.`],
  ['What is the entry ticket price?', `Basic entry to ${park.fullName} is generally free for visitors. Parking, amusement rides, the aviary / bird park and some activities may carry separate charges set by the CDA. Exact rates change, so check the current fee schedule at the gate.`],
  ['Can I bring outside food?', 'Many visitors bring their own snacks and picnic items for the lawns. On-site food stalls and tea shops also operate inside and around the park. Follow CDA rules and use the bins to keep the lawns clean.'],
  ['Is there a bird park or aviary?', `${park.fullName} is known for its aviary / bird park and is a recognized spot for waterbirds around Rawal Lake, especially in winter. Availability of the aviary and any entry charge follow the managing authority’s current policy.`],
  ['What are the main attractions?', 'Highlights include the open lakefront and viewpoints over Rawal Lake, boating when available, children’s play areas, green lawns for picnics, the aviary / bird park, and casual food stalls — a full family-outing list is in the park directory below.']
];

const faqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [...faqUr, ...faqEn].map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Lake View Park Islamabad Guide | Timings, Ticket Price &amp; Top Attractions</title>
  <meta name="description" content={`Plan your visit to ${park.fullName} (Rawal Lake) in ${park.city}, ${park.country}. Find opening timings, entry ticket price, boating, the bird & aviary park, family attractions, directions via Murree Road and live weather.`} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${park.fullName} Islamabad Guide — Timings, Ticket Price & Attractions`} />
  <meta property="og:description" content={`Visitor guide to ${park.fullName} (Rawal Lake), ${park.city}: timings, ticket price, boating, bird park, facilities and directions.`} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="ur_PK" />
  <meta property="og:url" content={SITE} />
  <meta property="og:image" content={`${SITE}${heroImg}`} />
  <meta property="og:image:alt" content={`${park.fullName} in ${park.city}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#143844" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Lake View Park" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  <link rel="icon" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <script type="application/ld+json" set:html={JSON.stringify(attractionJson)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-HXM22WWPKP');
  </script>
</head>
<body class="paper">
  <header class="absolute inset-x-0 top-0 z-20 px-5 py-5 text-white">
    <div class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-white/20 bg-black/15 px-5 py-3 backdrop-blur-md">
      <a href="#top" class="flex items-center gap-3 font-bold"><img src="/logo.svg" alt="" class="h-10 w-10" /><span>لیک ویو پارک</span></a>
      <nav class="hidden gap-5 text-sm md:flex">
        <a href="#about">تعارف</a>
        <a href="#transport">آمدورفت</a>
        <a href="#weather">موسم</a>
        <a href="#nearby">قریب کیا ہے</a>
        <a href="#faq">سوالات</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero-photo relative min-h-[90vh] overflow-hidden text-white">
      <img src={heroImg} alt={heroAlt} class="absolute inset-0 h-full w-full object-cover" loading="eager" />
      <div class="absolute inset-0" style="background-image: linear-gradient(100deg, rgba(6,24,29,.86), rgba(6,24,29,.25))"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#102b33] via-transparent to-transparent"></div>
      <div class="relative mx-auto flex min-h-[90vh] max-w-6xl items-end px-5 pb-16 pt-32 md:pb-24">
        <div class="max-w-3xl">
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-sm">راول جھیل • مری روڈ • اسلام آباد</div>
          <h1 class="section-title text-5xl font-black leading-[1.1] md:text-7xl">Lake View Park, Islamabad<span class="mt-3 block text-2xl font-bold text-[#f3be72] md:text-3xl">لیک ویو پارک اسلام آباد · Rawal Lake</span></h1>
          <p class="mt-6 max-w-2xl text-lg leading-9 text-white/85">Green lawns, an open lakefront, family picnics and children's rides — Lake View Park is an easy outdoor day just minutes from Islamabad's busy centre. Check the timings, ticket price and boating schedule before you go.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#plan" class="rounded-full bg-[#e5a04c] px-6 py-3 font-bold text-[#17333c]">سیر کی تیاری کریں</a>
            <a href={park.mapsShareUrl} class="rounded-full border border-white/35 bg-white/10 px-6 py-3" target="_blank" rel="noopener noreferrer">گوگل میپس کھولیں ↗</a>
          </div>
        </div>
      </div>
    </section>

    <!-- QUICK STATS -->
    <section class="mx-auto -mt-10 grid max-w-6xl gap-4 px-5 md:grid-cols-4">
      {[
        ['اوقات','روزانہ عموماً 10 صبح تا 10 رات'],
        ['داخلہ','بنیادی داخلہ مفت'],
        ['درجہ بندی', `${park.rating} / 5`],
        ['مدت','2–3 گھنٹے یا آدھا دن']
      ].map(([k,v]) => <div class="card-shadow rounded-3xl bg-white p-6"><div class="text-xs font-bold text-[#7c6c51]">{k}</div><div class="mt-2 text-lg font-black">{v}</div></div>)}
    </section>

    <!-- GOOGLE REVIEWS (display only — not in JSON-LD) -->
    <section id="reviews" class="mx-auto max-w-6xl px-5 py-16">
      <div class="rounded-[2rem] card-shadow bg-white p-8 md:p-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <div class="flex items-center gap-3">
              <span class="text-5xl font-black text-[#143844]">{park.rating}</span>
              <span class="text-2xl text-amber-500">★★★★★</span>
            </div>
            <div class="mt-1 text-sm text-slate-500">{park.category} · {park.reviewCount.toLocaleString('en-US')} 条评价</div>
          </div>
          <a href={park.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#e5a04c] px-6 py-3 font-bold text-[#17333c]">在谷歌地图查看全部评价 ↗</a>
        </div>
        <p class="mt-6 text-xs leading-6 text-slate-500">评分与评价数同步自谷歌地图（Google Maps）用户评价 · {park.ratingSync} · 点击查看谷歌地图全部评价↗</p>
        <p class="mt-2 text-xs leading-6 text-slate-500">同步自 Google 地图用户评价，同步时间 {park.ratingSync}；版权归原作者与 Google 地图所有</p>
      </div>
    </section>

    <!-- URDU INTRO -->
    <section class="mx-auto grid max-w-6xl gap-10 px-5 py-20 md:grid-cols-[1.05fr_.95fr] md:items-center">
      <div><p class="text-sm font-bold text-[#a66f2d]">راول جھیل کی فضا</p><h2 class="section-title mt-2 text-4xl font-black leading-[1.5]">یہاں اصل کشش "کرنے" سے زیادہ "ٹھہرنے" میں ہے</h2><p class="mt-5 text-lg text-slate-700">CDA کے مطابق پارک راول جھیل کے کنارے تفریح، واک، بچوں کے کھیل اور مقامی فوڈ اسٹالز کا مرکز ہے۔ کشتی رانی یا مخصوص سرگرمیوں کی دستیابی وقت اور انتظامی پابندیوں کے ساتھ بدل سکتی ہے، اس لیے انہیں یقینی سمجھ کر نہ جائیں۔</p></div>
      <img src={lakeImg} alt={`${park.fullName} - Rawal Lake view in ${park.city}`} class="h-[420px] w-full rounded-[2rem] object-cover card-shadow" loading="lazy" />
    </section>

    <!-- PLAN (Urdu) -->
    <section id="plan" class="bg-[#143844] py-20 text-white">
      <div class="mx-auto max-w-6xl px-5"><p class="text-sm font-bold text-[#f2b86d]">سیر کا منصوبہ</p><h2 class="mt-2 text-4xl font-black">جانے سے پہلے یہ جان لیں</h2><div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">🎟️ ٹکٹ / اخراجات</h3><p class="mt-3 text-white/75">CDA کے 2023 فیصلے کے مطابق Lake View Park کے بنیادی داخلے پر انٹری فیس نہیں۔ پارکنگ، رائیڈز، فوڈ اور نجی سرگرمیاں الگ ادائیگی پر ہو سکتی ہیں۔</p></article>
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">🚗 پارکنگ</h3><p class="mt-3 text-white/75">پارکنگ موجود ہے اور CDA نے پارکنگ فیس کی وصولی آؤٹ سورس کرنے کی منظوری دی تھی۔ اختتامِ ہفتہ جلد پہنچنا بہتر ہے۔</p></article>
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">🌤️ بہترین وقت</h3><p class="mt-3 text-white/75">ہفتے کے دن نسبتاً پرسکون؛ شام روشنی اور جھیل کے منظر کے لیے عمدہ۔ گرمی میں دوپہر کے بجائے صبح یا شام کو ترجیح دیں۔</p></article>
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">⏱️ قیام کی مدت</h3><p class="mt-3 text-white/75">صرف واک اور جھیل کے لیے 2–3 گھنٹے؛ پکنک، بچوں کے کھیل یا متعدد سرگرمیوں کے لیے آدھا دن رکھیں۔</p></article>
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">👟 ساتھ کیا لائیں</h3><p class="mt-3 text-white/75">آرام دہ جوتے، پانی، دھوپ سے بچاؤ اور مچھر بھگانے والی چیز کام آ سکتی ہے۔ پکنک کے لیے چادر یا میٹ مفید ہے۔</p></article>
        <article class="glass rounded-3xl border border-white/10 p-7"><h3 class="text-xl font-black">🛶 سرگرمیاں</h3><p class="mt-3 text-white/75">واک، پکنک، بچوں کے کھیل، فوٹوگرافی اور مختلف تفریحی زون۔ کشتی رانی/پانی کی سرگرمیاں دستیابی کے تابع ہیں۔</p></article>
      </div></div>
    </section>

    <!-- ABOUT (English / SEO entity binding) -->
    <section id="about" class="en mx-auto max-w-6xl px-5 py-20">
      <p class="text-sm font-bold text-[#a66f2d]">About</p>
      <h2 class="mt-2 text-4xl font-black">About {park.fullName}</h2>
      <p class="mt-5 max-w-3xl text-lg text-slate-700">
        Welcome to <strong>{park.fullName}</strong>, widely recognized as the central <strong>{park.shortName}</strong>. Located in the heart of <strong>{park.city}</strong>, <strong>{park.region}</strong>, <strong>{park.country}</strong>, this lakeside destination serves as a primary hub for travelers visiting the Rawal Lake area.
      </p>
      <nav aria-label="Breadcrumb" class="mt-6 inline-flex flex-wrap items-center gap-2 rounded-full bg-[#ece3cf] px-5 py-2 text-sm text-[#5b4a2f]">
        <span>{park.fullName}</span><span aria-hidden="true">→</span>
        <span>{park.city}</span><span aria-hidden="true">→</span>
        <span>{park.region}</span><span aria-hidden="true">→</span>
        <span>{park.country}</span>
      </nav>
      <p class="mt-6 max-w-3xl text-slate-700">
        When visiting <strong>{park.fullName}</strong>, visitors can easily explore surrounding landmarks and points of interest, including <strong>Rawal Dam & Rawal Lake viewpoints</strong> and <strong>Shakarparian / Pakistan Monument</strong>.
      </p>
    </section>

    <!-- TRANSPORT (English) + MAP -->
    <section id="transport" class="en mx-auto max-w-6xl px-5 py-20">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-bold text-[#a66f2d]">Getting here</p>
          <h2 class="mt-2 text-4xl font-black">Location &amp; How to Visit {park.shortName} in {park.city}</h2>
          <div class="mt-8 space-y-5">
            <div class="rounded-3xl bg-white p-6 card-shadow">
              <b>✈️ From the airport</b>
              <p class="mt-2 text-slate-700">Islamabad International Airport (ISB) is roughly 40 km northwest. A taxi or ride-hailing trip takes about 45–75 minutes via the Srinagar/Hague Road corridor and Murree Road, depending on traffic. Allow extra time at peak hours.</p>
            </div>
            <div class="rounded-3xl bg-white p-6 card-shadow">
              <b>🚌 Public transport</b>
              <p class="mt-2 text-slate-700">CDA bus routes serve the Murree Road corridor; from a nearby stop, a short taxi, rickshaw or ride-hailing leg reaches the park gate. Routes and timings change, so confirm the current schedule before you travel.</p>
            </div>
            <div class="rounded-3xl bg-white p-6 card-shadow">
              <b>🚕 Taxi &amp; ride-hailing</b>
              <p class="mt-2 text-slate-700">Ride-hailing apps and local taxis operate across {park.city}. Set the destination to "Lake View Park" or paste the Plus Code <code class="rounded bg-slate-100 px-1">{park.plusCode}</code> into your map app for the most accurate drop-off.</p>
            </div>
            <div class="rounded-3xl bg-white p-6 card-shadow">
              <b>🚗 Driving &amp; parking</b>
              <p class="mt-2 text-slate-700">Follow Murree Road toward the Rawal Dam / Lake View Park signs. On-site parking is available; it fills up on busy weekends and public holidays, so arriving earlier is easier.</p>
            </div>
          </div>
          <p class="mt-8 text-sm text-slate-600">
            For official regional tourism information, visit the
            <a class="font-semibold text-[#a66f2d] underline" href={park.govtTourismUrl} target="_blank" rel="noopener noreferrer"> Pakistan Tourism Development Corporation portal ↗</a>.
          </p>
        </div>
        <div class="overflow-hidden rounded-[2rem] card-shadow">
          <iframe title="Lake View Park location map" class="h-[560px] w-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={park.mapsEmbed}></iframe>
        </div>
      </div>
    </section>

    <!-- WEATHER (English, live via server proxy) -->
    <section id="weather" class="en mx-auto max-w-6xl px-5 py-20">
      <p class="text-sm font-bold text-[#a66f2d]">Live conditions &amp; what to do about them</p>

      function uvWord(u) { return u >= 8 ? 'very high' : u >= 5 ? 'high' : u >= 3 ? 'moderate' : 'low'; }
      function windWord(b) { return b >= 7 ? 'gale' : b >= 5 ? 'strong wind' : b >= 3 ? 'noticeable breeze' : 'light air'; }
      function hm(iso) { var p = (iso || '').split('T')[1]; return p ? p.slice(0, 5) : ''; }
      function dow(iso, i) {
        if (i === 0) return 'Today';
        if (i === 1) return 'Tomorrow';
        var d = new Date(iso + 'T00:00');
        return ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][d.getDay()];
      }
      function n0(v) { return v === null || v === undefined ? 0 : v; }

      // One day of data in, only the advice whose conditions are actually met comes out.
      function advise(o) {
        var alerts = [], wear = [], plan = [], bring = [];
        var pop = n0(o.pop), psum = n0(o.psum), uv = n0(o.uv);
        // Sustained wind is what you feel all day; gusts are what makes things unsafe.
        var bw = bf(n0(o.wind)), bg = bf(n0(o.gust));

        var rain = 'none';
        if (o.code >= 95) rain = 'thunder';
        else if (o.code >= 51 && o.code <= 57) rain = 'drizzle';
        else if (o.code === 61 || o.code === 80) rain = 'light';
        else if ((o.code >= 62 && o.code <= 67) || o.code === 81 || o.code === 82) rain = 'heavy';
        else if ((o.code >= 71 && o.code <= 77) || o.code === 85 || o.code === 86) rain = 'snow';

        if (rain === 'thunder') {
          alerts.push({ t: 'Thunderstorm in the forecast', d: 'Lightning risk: stay off the hillside, out of the water and away from isolated trees. Boating and lake activities are likely to be suspended.' });
          wear.push('Wet and stormy—waterproof shoes and a hooded layer.');
          plan.push('Water activities on Rawal Lake will most likely close—keep an indoor or sheltered option in mind.');
          bring.push('A hooded rain jacket, safer than an umbrella in lightning');
        } else if (rain === 'heavy' || psum >= 10) {
          alerts.push({ t: 'Heavy rain in the forecast', d: 'Avoid low-lying ground, the dam spillway area and stream beds—water rises fast in a monsoon downpour.' });
          wear.push('Wet day—waterproof shoes and quick-drying clothes.');
          plan.push('Outdoor plans are a poor bet; boating and open-air rides are often suspended in heavy rain.');
          bring.push('A rain jacket rather than a long umbrella');
        } else if (pop >= 60) {
          wear.push('Rain is likely, around ' + pop + '% chance—carry a rain layer.');
          plan.push('Keep a sheltered alternative in mind; open-air activities are less pleasant in the wet.');
          bring.push('Folding umbrella');
        } else if (rain === 'light') {
          wear.push('Showers around—paths and stone steps turn slippery, watch your footing.');
          bring.push('Folding umbrella');
        } else if (rain === 'drizzle') {
          wear.push('Drizzle—surfaces get slick, take care along the lakeside path.');
          plan.push('Drizzle rarely ruins a visit: fine for a walk, poor for distant views and photos.');
          bring.push('Compact umbrella');
        } else if (rain === 'snow') {
          alerts.push({ t: 'Snow or sleet in the forecast', d: 'Surfaces turn slick; the lakeside path and any sloped ground need extra care.' });
          plan.push('Expect a changed park: slippery paths and likely closures—keep the plan flexible.');
          bring.push('Warm, waterproof shoes');
        }

        if (o.tmax >= 32) {
          wear.push('Hot day, up to ' + Math.round(o.tmax) + '°C—light, breathable clothing.');
          plan.push('Keep outdoor time short and stay out of the midday sun.');
          bring.push('Plenty of drinking water');
        }
        if (uv >= 5) {
          wear.push(uv >= 8 ? 'UV is very strong—cover up rather than bake.' : 'UV is strong—sun protection is worth it.');
          bring.push('Sunscreen, sunglasses, a sun hat');
        }
        if (o.tmax <= 10) {
          wear.push('Cold day—dress warm in layers.');
          bring.push('Warm coat, scarf');
        }
        if (o.tmax - o.tmin > 8) {
          wear.push('Big day-to-night swing, ' + Math.round(o.tmin) + '° to ' + Math.round(o.tmax) + '°C—bring an extra layer for the evening.');
        }
        if (n0(o.humidity) >= 75 && o.tmax >= 28) wear.push('Muggy rather than simply hot—loose fabrics feel far better.');

        if (bw >= 7 || bg >= 7) {
          alerts.push({ t: 'Strong wind, gusts to force ' + Math.max(bw, bg), d: 'Stay clear of billboards, temporary structures and the exposed lakeshore; boating on Rawal Lake is likely suspended.' });
          wear.push('Very windy—secure layers, and leave loose accessories behind.');
          plan.push('Open-water and exposed-viewpoint activities are likely closed.');
        } else if (bw >= 5 || bg >= 6) {
          wear.push('Windy—a wind-resistant layer helps.');
          plan.push('Boating and some open-air rides may be suspended once gusts pick up.');
          bring.push('A hat that stays on; loose, flowing clothes are a nuisance in wind');
        }

        if (o.code === 45 || o.code === 48) {
          alerts.push({ t: 'Fog', d: 'Poor visibility—take extra care on the dam approach road, and expect no view from the viewpoint.' });
          wear.push('Murky and damp—a light layer you can shed once it clears.');
          plan.push('Skip the viewpoint today; there will be nothing to see.');
          bring.push('A mask if haze bothers you');
        }

        if (o.code === 0 || o.code === 1) plan.push('Clear skies—ideal for the lake viewpoint and for sunset over the water.');
        else if (o.code === 2 || o.code === 3) plan.push('Soft, even light: the best conditions for photos, and comfortable for a long walk.');

        if (!alerts.length && rain === 'none' && pop < 60 && bw <= 4 && bg <= 5 && o.tmax >= 18 && o.tmax <= 34) {
          plan.push('Conditions suit a boat ride and an unhurried lakeside walk.');
        }

        if (!wear.length) wear.push('Comfortable conditions—dress for the season and you will be fine.');
        if (!plan.length) {
          plan.push(alerts.length
            ? 'Keep the plan flexible and check conditions locally before you go.'
            : 'No weather constraints today—plan your visit as you like.');
        }
        if (!bring.length) bring.push('Nothing special; water and sun protection as usual.');

        return {
          alerts: alerts,
          wear: wear,
          plan: plan,
          bring: bring,
          umbrella: rain === 'thunder' || rain === 'heavy' || rain === 'light' || rain === 'drizzle' || pop >= 60
        };
      }

      function dayAt(i) {
        var d = DATA.daily;
        return {
          code: d.weather_code[i],
          tmax: d.temperature_2m_max[i],
          tmin: d.temperature_2m_min[i],
          pop: d.precipitation_probability_max ? d.precipitation_probability_max[i] : null,
          psum: d.precipitation_sum ? d.precipitation_sum[i] : null,
          wind: d.wind_speed_10m_max ? d.wind_speed_10m_max[i] : null,
          gust: d.wind_gusts_10m_max ? d.wind_gusts_10m_max[i] : null,
          uv: d.uv_index_max ? d.uv_index_max[i] : null,
          humidity: DATA.current ? DATA.current.relative_humidity_2m : null
        };
      }

      function renderNow() {
        var c = DATA.current, d = DATA.daily, k = wmo(c.weather_code);
        var pop = d.precipitation_probability_max ? d.precipitation_probability_max[0] : null;
        var uv = d.uv_index_max ? d.uv_index_max[0] : null;
        var el = document.getElementById('weather-now');
        el.className = 'mt-6 rounded-[2rem] card-shadow bg-white p-8';
        el.innerHTML =
          '<div class="flex flex-wrap items-center justify-between gap-6">' +
            '<div class="flex items-center gap-5">' +
              '<div class="text-6xl">' + k.i + '</div>' +
              '<div><div class="text-5xl font-black text-[#143844]">' + Math.round(c.temperature_2m) + '°C</div>' +
              '<div class="text-slate-500">' + k.t + ' · feels like ' + Math.round(c.apparent_temperature) + '°C</div></div>' +
            '</div>' +
            '<div class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm text-slate-600">' +
              '<div>Raining now: <b>' + (n0(c.precipitation) > 0 ? 'yes' : 'no') + '</b></div>' +
              '<div>Chance today: <b>' + (pop === null ? '—' : pop + '%') + '</b></div>' +
              '<div>Wind: <b>' + Math.round(c.wind_speed_10m) + ' km/h</b>' + (c.wind_gusts_10m ? ', gusts ' + Math.round(c.wind_gusts_10m) : '') + '</div>' +
              '<div>UV today: <b>' + (uv === null ? '—' : uvWord(uv)) + '</b></div>' +
            '</div>' +
          '</div>';
      }

      function renderAdvice() {
        var d = DATA.daily, o = dayAt(selected), a = advise(o), k = wmo(o.code);

        var al = document.getElementById('weather-alerts');
        al.innerHTML = a.alerts.length
          ? '<div class="rounded-2xl border-l-4 border-[#b3261e] bg-[#fdecea] p-5">' +
              '<p class="text-sm font-black text-[#b3261e]">⚠️ Risk alerts — ' + dow(d.time[selected], selected) + '</p>' +
              a.alerts.map(function (x) { return '<p class="mt-2 text-sm text-[#7a1c16]"><b>' + x.t + '.</b> ' + x.d + '</p>'; }).join('') +
            '</div>'
          : '';

        var head =
          '<div class="flex flex-wrap items-center gap-3 rounded-2xl bg-white p-5 card-shadow">' +
            '<p class="text-sm font-black text-[#143844]">' + dow(d.time[selected], selected) + ' · ' + k.i + ' ' + k.t + ' · ' +
              Math.round(o.tmin) + '–' + Math.round(o.tmax) + '°C · UV ' + uvWord(n0(o.uv)) + ' · ' +
              windWord(bf(n0(o.wind))) + (bf(n0(o.gust)) > bf(n0(o.wind)) ? ', gusts to force ' + bf(n0(o.gust)) : '') + '</p>' +
            '<span class="rounded-full px-3 py-1 text-xs font-bold ' + (a.umbrella ? 'bg-[#143844] text-white' : 'bg-[#ece3cf] text-[#5b4a2f]') + '">' +
              (a.umbrella ? '☂️ Take an umbrella' : '☀️ No umbrella needed') + '</span>' +
          '</div>';

        var block = function (icon, title, items) {
          if (!items.length) return '';
          return '<div class="rounded-2xl bg-white p-5 card-shadow">' +
            '<p class="text-sm font-black text-[#143844]">' + icon + ' ' + title + '</p>' +
            '<ul class="mt-2 space-y-1 text-sm text-slate-600">' +
            items.map(function (t) { return '<li>· ' + t + '</li>'; }).join('') +
            '</ul></div>';
        };

        document.getElementById('weather-advice').innerHTML = head +
          '<div class="mt-4 grid gap-4 md:grid-cols-3">' +
            block('✅', 'What to wear', a.wear) +
            block('🗺️', 'How to plan', a.plan) +
            block('🎒', 'What to bring', a.bring) +
          '</div>';
      }

      function renderDays() {
        var d = DATA.daily, wrap = document.getElementById('weather-days');
        wrap.innerHTML = '';
        cards = [];
        for (var i = 0; i < d.time.length; i++) {
          (function (i) {
            var o = dayAt(i), a = advise(o), k = wmo(o.code);
            var card = document.createElement('button');
            card.type = 'button';
            card.className = 'w-full rounded-2xl bg-white p-4 text-center card-shadow transition hover:-translate-y-0.5' +
              (i === selected ? ' ring-2 ring-[#143844]' : '');
            card.innerHTML =
              '<div class="text-xs font-bold text-slate-400">' + dow(d.time[i], i) + '</div>' +
              '<div class="my-2 text-3xl">' + k.i + '</div>' +
              '<div class="text-sm font-black text-[#143844]">' + Math.round(o.tmax) + '° / ' + Math.round(o.tmin) + '°</div>' +
              '<div class="mt-1 text-xs text-slate-500">💧 ' + (o.pop === null ? '—' : o.pop + '%') + '</div>' +
              '<div class="mt-1 text-xs">' +
                (a.alerts.length ? '<span class="font-bold text-[#b3261e]">⚠️ risk</span>' : (a.umbrella ? '☂️' : '✅')) +
              '</div>';
            card.addEventListener('click', function () {
              selected = i;
              for (var j = 0; j < cards.length; j++) {
                if (j === i) { cards[j].classList.add('ring-2'); cards[j].classList.add('ring-[#143844]'); }
                else { cards[j].classList.remove('ring-2'); cards[j].classList.remove('ring-[#143844]'); }
              }
              renderAdvice();
            });
            cards.push(card);
            wrap.appendChild(card);
          })(i);
        }
      }

      fetch('/api/weather')
        .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function (data) {
          DATA = data;
          renderNow();
          renderDays();
          renderAdvice();
          var up = document.getElementById('weather-updated');
          if (up) up.textContent = 'Reading taken ' + hm(data.current.time) + ' · Sunrise ' + hm(data.daily.sunrise[0]) + ' · Sunset ' + hm(data.daily.sunset[0]) + ' (local park time)';
        })
        .catch(function () {
          var n = document.getElementById('weather-now');
          if (n) { n.className = 'mt-6 rounded-[2rem] card-shadow bg-white p-8 text-slate-500'; n.textContent = 'Weather information is temporarily unavailable. Please check again shortly.'; }
        });
    })();
  </script>
</body>
</html>

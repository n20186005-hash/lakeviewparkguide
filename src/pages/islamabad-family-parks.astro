---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import Checklist from '../components/Checklist.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
---
<SubpageLayout
  title="Family Parks in Islamabad: Lake View Park & Alternatives"
  description="Family parks in Islamabad: Lake View Park and alternatives like F-9 Park, with notes on what suits kids, picnics and lake time."
  path="/islamabad-family-parks/"
  faq={[
    { q: 'Which Islamabad parks work for families?', a: 'Lake View Park (lakeside, with lawns, viewpoints, kids’ activities and boating when operating) and F-9 Park (large central green space) are the well-known ones, plus formal gardens and sector playgrounds for quicker visits.' },
    { q: 'Which is best for a longer family outing?', a: 'Lake View Park suits a longer outing built around the water; F-9 Park is handy if you’re already in the F-/G-sectors and want a lake-free visit.' },
    { q: 'Are these parks verified for facilities?', a: 'No — this guide hasn’t confirmed specific amenities, hours or charges at these parks. Check each destination’s current information before you go.' },
    { q: 'What about the Margalla trails?', a: 'The Margalla foothills trails suit older children and hikers, but they have their own safety checks (terrain, wildlife, heat) — prepare differently from a city park.' },
  ]}
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Islamabad family parks', href: '/islamabad-family-parks/' }]}
  image="/images/rawal-lake-islamabad-view.jpg"
  related={[
    { label: 'Lake View Park vs F-9 Park', href: '/lake-view-park-vs-f9-park/' },
    { label: 'Family guide', href: '/family-guide/' },
    { label: 'Picnic guide', href: '/picnic-guide/' },
    { label: 'Nearby attractions', href: '/nearby-attractions/' },
  ]}
>
  <article class="space-y-8">
    <p class="text-lg leading-8 text-slate-700">Islamabad has several green spaces that work for families. This page groups the well-known ones and notes which suits which plan — without inventing verified facilities.</p>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Lake View Park</h2>
      <p class="mt-3 leading-8">Lakeside location with open lawns, viewpoints, children’s activities and boating when operating. Best for a longer family outing built around the water (see the <a class="font-semibold text-[#a66f2d] underline" href="/family-guide/">family guide</a>).</p>
    </section>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">F-9 Park (Fatima Jinnah Park)</h2>
      <p class="mt-3 leading-8">A large central city park with open green space and walking tracks, handy if you are already in the F-/G-sectors and want a lake-free visit.</p>
    </section>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Other green options</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 leading-8">
        <li><strong>Rose & Jasmine Garden</strong> and similar formal gardens — pleasant, calmer strolls.</li>
        <li><strong>Playgrounds within sector parks</strong> — useful for quick, local play close to home.</li>
        <li><strong>Margalla foothills trails</strong> — for older children and hikers, with their own safety checks.</li>
      </ul>
    </section>

    <div class="rounded-2xl bg-[#f3ede0] p-5">
      <p class="text-sm font-black text-[#5b4a2f]">Verify before you go</p>
      <p class="mt-2 text-sm leading-7 text-[#5b4a2f]">This guide has not confirmed specific amenities, hours or charges at these parks. Check each destination’s current information, and pick by what your family actually needs that day.</p>
    </div>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Match the park to the day</h2>
      <p class="mt-3 leading-8">Islamabad’s green spaces serve different plans. Lead with what your family actually needs — lake time, a quick walk, or a playground close to home — and confirm each destination’s current facilities rather than assuming they match a photo.</p>
    </section>

    <Checklist title="Family parks checklist" items={[
      'For a longer water-focused outing → Lake View Park.',
      'For a quick central visit → F-9 Park.',
      'For small kids nearby → a sector playground.',
      'For older kids → Margalla trails, with proper prep.',
    ]} />

    <figure>
      <img src="/images/rawal-lake-islamabad-view.jpg" width="1440" height="960" alt="Lakeside structure at Rawal Lake near Lake View Park, Islamabad" class="h-[360px] w-full rounded-[2rem] object-cover card-shadow" loading="lazy" />
      <figcaption><PhotoCredit photo={3} /></figcaption>
    </figure>
  </article>
</SubpageLayout>

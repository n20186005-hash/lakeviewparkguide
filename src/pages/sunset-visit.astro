---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import Checklist from '../components/Checklist.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
---
<SubpageLayout
  title="Lake View Park Sunset Visit Guide"
  description="Lake View Park sunset visit: best viewpoints, seasonal sunset timing, return transport and safety before dark."
  path="/sunset-visit/"
  faq={[
    { q: 'What is the best spot for sunset at Lake View Park?', a: 'The open lakefront and any west-facing viewpoint give the cleanest light over the water and hills. Arrive 30–45 minutes before sunset to settle in.' },
    { q: 'What time is sunset?', a: 'Sunset shifts through the year — earlier in winter, later in summer. This guide does not publish a fixed clock time; check the day’s sunset in the park weather guidance before you go.' },
    { q: 'How do I get back after sunset?', a: 'Book your ride-hail or taxi before the park quiets, since evening supply can thin out. After sunset, paths and the lake edge are harder to see, so keep to lit, firm ground.' },
    { q: 'Is the sunset visit safe in rain?', a: 'In rain or thunderstorms, prioritise leaving safely over the view, and confirm your return transport while you still have signal.' },
  ]}
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Sunset visit', href: '/sunset-visit/' }]}
  image="/images/rawal-lake-islamabad.jpg"
  related={[
    { label: 'Rawal Lake views', href: '/rawal-lake-views/' },
    { label: 'Best time to visit', href: '/best-time-to-visit/' },
    { label: 'Taxi & ride-hailing', href: '/taxi-ride-hailing/' },
    { label: 'Weather at the park', href: '/#weather' },
  ]}
>
  <article class="space-y-8">
    <p class="text-lg leading-8 text-slate-700">Sunset is one of the most photogenic times at the lake — but it also means planning your exit before it gets dark.</p>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Best spots</h2>
      <p class="mt-3 leading-8">The open lakefront and any west-facing viewpoint give the cleanest light over the water and the hills. Arrive 30–45 minutes before sunset to settle in.</p>
    </section>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Seasonal timing</h2>
      <p class="mt-3 leading-8">Sunset time shifts through the year — earlier in winter, later in summer. This guide does not publish a fixed clock time; check the day’s sunset in <a class="font-semibold text-[#a66f2d] underline" href="/#weather">the park weather guidance</a> before you go.</p>
    </section>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Return and safety</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 leading-8">
        <li>Book your ride-hail or taxi before the park quiets; evening supply can thin out.</li>
        <li>After sunset, paths and the lake edge are harder to see — keep to lit, firm ground.</li>
        <li>In rain or thunderstorms, prioritise leaving safely over the view.</li>
      </ul>
    </section>

    <div class="rounded-2xl bg-[#f3ede0] p-5">
      <p class="text-sm font-black text-[#5b4a2f]">Confirm the day’s details</p>
      <p class="mt-2 text-sm leading-7 text-[#5b4a2f]">Sunset time, gate hours and activity operation are not CDA-confirmed. Verify the live sunset and plan your exit with buffer for traffic.</p>
    </div>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Time your exit</h2>
      <p class="mt-3 leading-8">Sunset is photogenic but means planning the way out before dark. Arrange your return while you still have signal, keep to lit and firm paths after the light fades, and let safety win over the view if weather turns.</p>
    </section>

    <Checklist title="Sunset visit checklist" items={[
      'Arrive 30–45 minutes before sunset to settle in.',
      'Check the day’s sunset time in the weather guidance.',
      'Book your return ride before the park quiets.',
      'Keep to lit, firm ground after dark; leave if storms come.',
    ]} />

    <figure>
      <img src="/images/rawal-lake-islamabad.jpg" width="1280" height="960" alt="Calm Rawal Lake view from Lake View Park, Islamabad" class="h-[360px] w-full rounded-[2rem] object-cover card-shadow" loading="lazy" />
      <figcaption><PhotoCredit photo={2} /></figcaption>
    </figure>
  </article>
</SubpageLayout>

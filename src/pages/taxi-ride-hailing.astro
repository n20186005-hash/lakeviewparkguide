---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import Checklist from '../components/Checklist.astro';
import { park } from '../data/park';
import PhotoCredit from '../components/PhotoCredit.astro';
---
<SubpageLayout
  title="Taxi & Ride-Hailing Guide to Lake View Park"
  description="Taxi and ride-hailing to Lake View Park Islamabad: which apps to use, how to set the destination, and return tips for an evening visit."
  path="/taxi-ride-hailing/"
  faq={[
    { q: 'Which apps can I use for Lake View Park?', a: 'Ride-hailing apps and local taxis operate across Islamabad and are a straightforward way to reach the park without driving or parking. This guide doesn’t name or endorse a specific app.' },
    { q: 'How do I set the destination correctly?', a: 'Enter “Lake View Park” or paste the Plus Code shown on this page into your map app, so the driver doesn’t drop you at the wrong gate or a distant point on Murree Road.' },
    { q: 'What do rides cost?', a: 'This guide doesn’t publish fares because they vary with distance, demand and surge. Use the app’s quote or meter, and agree a price for a local taxi before boarding.' },
    { q: 'How do I get back in the evening?', a: 'Ride-hail supply can thin out in the evening and after events, so book your return while you still have signal and before the park gets quiet — especially after sunset.' },
  ]}
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Taxi & ride-hailing', href: '/taxi-ride-hailing/' }]}
  image="/images/lake-view-park-rawal-lake.jpg"
  related={[
    { label: 'How to get there', href: '/how-to-get-there/' },
    { label: 'Public transport', href: '/public-transport/' },
    { label: 'Parking', href: '/parking/' },
    { label: 'Sunset visit', href: '/sunset-visit/' },
  ]}
>
  <article class="space-y-8">
    <p class="text-lg leading-8 text-slate-700">Ride-hailing apps and local taxis operate across Islamabad and are a straightforward way to reach Lake View Park without driving or parking.</p>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Set the right destination</h2>
      <p class="mt-3 leading-8">Enter “Lake View Park” as the destination, or paste the Plus Code <code class="rounded bg-slate-100 px-1">{park.plusCode}</code> into your map app. This avoids dropping you at the wrong gate or a distant point on Murree Road.</p>
    </section>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Confirm the drop-off</h2>
      <p class="mt-3 leading-8">Ask the driver to use the currently open gate and a lawful drop-off. On busy days, the nearest gate to your plans (lakefront vs play areas) can matter, so mention your focus.</p>
    </section>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Plan the return</h2>
      <p class="mt-3 leading-8">Ride-hail supply can thin out in the evening and after events. Book your return while you still have signal and before the park gets quiet — especially if you stay for sunset (see the <a class="font-semibold text-[#a66f2d] underline" href="/sunset-visit/">sunset visit guide</a>).</p>
    </section>

    <div class="rounded-2xl bg-[#f3ede0] p-5">
      <p class="text-sm font-black text-[#5b4a2f]">Fares are metered or app-quoted</p>
      <p class="mt-2 text-sm leading-7 text-[#5b4a2f]">This guide does not publish taxi or ride-hail fares because they vary with distance, demand and surge. Use the app’s quote or the meter, and agree a price for a local taxi before you board.</p>
    </div>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Make the ride smooth</h2>
      <p class="mt-3 leading-8">A ride-hail or taxi removes the parking question entirely. Pin the right destination, confirm the drop-off gate with the driver, and sort the return while you still have signal so the end of the day is as easy as the start.</p>
    </section>

    <Checklist title="Ride-hailing checklist" items={[
      'Set “Lake View Park” or the Plus Code as the destination.',
      'Ask for the open gate and lawful drop-off.',
      'Use the app quote or meter; agree local taxi fares first.',
      'Book your return before the park gets quiet.',
    ]} />

    <figure>
      <img src="/images/lake-view-park-rawal-lake.jpg" width="1280" height="960" alt="Lake View Park lakeshore along Rawal Lake, Islamabad" class="h-[360px] w-full rounded-[2rem] object-cover card-shadow" loading="lazy" />
      <figcaption><PhotoCredit photo={1} /></figcaption>
    </figure>
  </article>
</SubpageLayout>

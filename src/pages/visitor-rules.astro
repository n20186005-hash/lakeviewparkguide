---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import Checklist from '../components/Checklist.astro';
---
<SubpageLayout
  title="Lake View Park Rules & Visitor Safety Guide"
  description="Lake View Park rules and safety: opening conduct, litter, wildlife, boating and weather. Practical guidance for a safe family visit."
  path="/visitor-rules/"
  faq={[
    { q: 'What are the main rules at Lake View Park?', a: 'General guidance: keep to marked paths, supervise children near water, use bins and avoid single-use plastic, keep distance from wildlife, and only use managed boating with provided safety gear. On-site CDA signs and staff instructions are authoritative and take priority.' },
    { q: 'Can I swim in Rawal Lake?', a: 'No — never enter the water outside managed activity. The lake is a reservoir; only use managed boating when it is open and wear the provided safety gear.' },
    { q: 'Can I feed or approach the birds?', a: 'Keep a distance, lower your voice and skip flash photography, especially in winter when migratory birds are present. Avoid feeding wildlife.' },
    { q: 'What happens in bad weather?', a: 'During rain, thunderstorms, strong wind or fog, paths and lake edges get slippery and exposed areas are unsafe. Check the park weather guidance and any official PMD warnings before and during your visit.' },
  ]}
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Rules & safety', href: '/visitor-rules/' }]}
  image="/images/rawal-lake-islamabad.jpg"
  related={[
    { label: 'Visitor facilities', href: '/visitor-facilities/' },
    { label: 'Boating', href: '/boating/' },
    { label: 'Rainy day guide', href: '/rainy-day-guide/' },
    { label: 'Park directory', href: '/park-directory/' },
  ]}
>
  <article class="space-y-8">
    <p class="text-lg leading-8 text-slate-700">Practical conduct and safety guidance for Lake View Park. The park is managed by CDA, so always follow any on-site rules and staff instructions, which take priority over this general guide.</p>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">General conduct</h2>
      <p class="mt-3 leading-8">Keep to marked paths, supervise children near the water, and respect other visitors’ space. The appeal of the park is calm lake time, so moderate noise and litter help everyone.</p>
    </section>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Litter and plastics</h2>
      <p class="mt-3 leading-8">Use the bins provided and avoid single-use plastic where possible. Rawal Lake is a reservoir and green refuge; small habits keep the shore clean.</p>
    </section>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Wildlife and birding etiquette</h2>
      <p class="mt-3 leading-8">Winter brings migratory birds. Keep a distance, lower your voice, and skip flash photography so wildlife is not disturbed. The non-functional aviary is separate from wild birds around the lake.</p>
    </section>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Water and boating safety</h2>
      <p class="mt-3 leading-8">Only use managed boating when it is open, wear the provided safety gear, and keep children supervised near the edge. Never enter the water outside managed activity (see the <a class="font-semibold text-[#a66f2d] underline" href="/boating/">boating page</a>).</p>
    </section>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Weather and safety</h2>
      <p class="mt-3 leading-8">During rain, thunderstorms, strong wind or fog, paths and lake edges get slippery and exposed areas are unsafe. Check <a class="font-semibold text-[#a66f2d] underline" href="/#weather">the park weather guidance</a> and any official PMD warnings before and during your visit.</p>
    </section>

    <div class="rounded-2xl border-l-4 border-[#b3261e] bg-[#fdecea] p-5">
      <p class="text-sm font-black text-[#b3261e]">Follow CDA on site</p>
      <p class="mt-2 text-sm leading-7 text-[#7a1c16]">This page is general visitor guidance, not an official rulebook. On-site CDA signs and staff instructions are authoritative and may differ by area or event.</p>
    </div>

    <section>
      <h2 class="text-2xl font-black text-[#143844]">Respect the reservoir</h2>
      <p class="mt-3 leading-8">Rawal Lake is a working water reservoir and a green refuge for Islamabad, not just a park backdrop. Keeping litter out of the water, avoiding single-use plastic and staying on marked paths all help protect it. Small habits from every visitor add up to a cleaner shore and healthier birdlife.</p>
    </section>

    <Checklist items={[
      'Keep children supervised near the water at all times.',
      'Follow all on-site CDA signs and staff instructions.',
      'Use bins and avoid single-use plastic to protect Rawal Lake.',
      'Only use managed boating, with provided safety gear.',
      'Check the weather and avoid the lake edge in rain or strong wind.',
    ]} />

    <figure>
      <img src="/images/rawal-lake-islamabad.jpg" width="1280" height="960" alt="Calm Rawal Lake view from Lake View Park, Islamabad" class="h-[360px] w-full rounded-[2rem] object-cover card-shadow" loading="lazy" />
      <figcaption><PhotoCredit photo={2} /></figcaption>
    </figure>
  </article>
</SubpageLayout>
